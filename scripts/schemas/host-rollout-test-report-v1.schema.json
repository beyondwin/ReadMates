{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readmates.example/schemas/host-rollout-test-report-v1.schema.json",
  "title": "ReadMates host rollout structured test report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "group", "commands", "cases", "completedAt"],
  "properties": {
    "schemaVersion": {"const": "readmates.host-rollout.test-report.v1"},
    "group": {"enum": ["cache-safety", "compatibility", "security"]},
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]{1,80}$"},
          "result": {"const": "PASS"},
          "source": {"const": "structured-test-reporter"}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "commandId"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]{1,100}$"},
          "result": {"const": "PASS"},
          "commandId": {"type": "string", "pattern": "^[a-z0-9-]{1,80}$"}
        }
      }
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
